{
  "name": "peac-payment-evidence-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference example: portable payment evidence for x402 interactions using PEAC records.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "fixture": "tsx src/fixture-demo.ts",
    "demo:fixture": "tsx src/fixture-demo.ts",
    "demo:offline": "tsx src/fixture-demo-offline.ts",
    "test": "pnpm test:imports && pnpm test:golden && pnpm test:negative && pnpm test:acceptance && pnpm typecheck && pnpm typecheck:compat",
    "test:imports": "tsx src/imports-smoke.ts",
    "test:golden": "tsx src/test-golden.ts",
    "test:negative": "tsx src/test-negative.ts",
    "test:acceptance": "tsx src/test-acceptance.ts",
    "gen:golden": "tsx src/gen-golden.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:compat": "./run-ts-compat.sh"
  },
  "dependencies": {
    "@peac/crypto": "0.16.4",
    "@peac/kernel": "0.16.4",
    "@peac/protocol": "0.16.4",
    "@peac/schema": "0.16.4",
    "@x402/core": "2.21.0",
    "@x402/express": "2.21.0",
    "@x402/extensions": "2.21.0",
    "@x402/svm": "2.21.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@typescript/typescript6": "6.0.2",
    "ajv": "8.18.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}
